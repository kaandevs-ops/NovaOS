/* Trusted PID1 console only: bounded read-only supervised-process diagnostics. */
static unsigned long long r24_parse_unsigned(const char**p){unsigned long long v=0;while(**p==' '||**p=='\t')(*p)++;while(**p>='0'&&**p<='9'){unsigned int digit=(unsigned int)(*(*p)++-'0');if(v>(0xffffffffffffffffULL-digit)/10ULL)return 0;v=v*10ULL+digit;}return v;}
static int r24_read_proc(const char*path,char*out,unsigned int cap){long fd=nova_open_ro(path);if(fd<0)return 0;long n=nova_read((int)fd,out,cap-1);nova_close((int)fd);if(n<=0)return 0;out[n]=0;return 1;}
static void r24_proc_path(unsigned int pid,const char*name,char*out){char a[16];unsigned int n=0,j=0;do{a[n++]=(char)('0'+pid%10);pid/=10;}while(pid);const char*prefix="/proc/";while(*prefix)out[j++]=*prefix++;while(n)out[j++]=a[--n];out[j++]='/';while(*name)out[j++]=*name++;out[j]=0;}
static long r24_getdents(int fd,void*bytes,unsigned long cap){
#if defined(__aarch64__)
return nova_syscall3(61,fd,(long)bytes,(long)cap);
#else
return nova_syscall3(217,fd,(long)bytes,(long)cap);
#endif
}
static unsigned int r24_fd_count(unsigned int pid){char path[64],bytes[1024];r24_proc_path(pid,"fd",path);long fd=nova_open_ro(path);if(fd<0)return ~0U;unsigned int total=0;for(unsigned int block=0;block<128;block++){long n=r24_getdents((int)fd,bytes,sizeof(bytes));if(n<=0){nova_close((int)fd);return n==0?total:~0U;}unsigned long offset=0;while(offset+20U<=(unsigned long)n){unsigned char*p=(unsigned char*)bytes+offset;unsigned int length=(unsigned int)p[16]|((unsigned int)p[17]<<8);if(length<20U||offset+length>(unsigned long)n){nova_close((int)fd);return ~0U;}if(p[19]!='.')total++;offset+=length;}}nova_close((int)fd);return ~0U;}
static int r24_proc_fields(const char*text,unsigned long long*utime,unsigned long long*stime,unsigned long long*rss){const char*last=0;for(const char*p=text;*p;p++)if(*p==')')last=p;if(!last||last[1]!=' '||!last[2])return 0;const char*p=last+2;while(*p&&*p!=' ')p++;for(unsigned int field=4;field<=24;field++){while(*p==' ')p++;int negative=*p=='-';if(negative)p++;if(*p<'0'||*p>'9')return 0;unsigned long long value=r24_parse_unsigned(&p);if(field==14)*utime=value;if(field==15)*stime=value;if(field==24)*rss=negative?0:value;}return 1;}
static void r24_diag_process(unsigned int pid){char path[64],bytes[2048];unsigned long long u=0,s=0,rss=0;r24_proc_path(pid,"stat",path);int ok=r24_read_proc(path,bytes,sizeof(bytes))&&r24_proc_fields(bytes,&u,&s,&rss);nova_puts("{\"pid\":");nova_put_u64(pid);nova_puts(",\"available\":");nova_put_u64(ok);nova_puts(",\"utime_ticks\":");nova_put_u64(u);nova_puts(",\"stime_ticks\":");nova_put_u64(s);nova_puts(",\"rss_pages\":");nova_put_u64(rss);nova_puts(",\"fd_count\":");unsigned int fds=r24_fd_count(pid);if(fds==~0U)nova_puts("null");else nova_put_u64(fds);nova_puts("}");}
static void cmd_r24_diagnostics(void){if(nova_getpid()!=1){nova_putln("diagnostics: PID1 console required");return;}struct nova_timespec now;nova_zero(&now,sizeof(now));nova_clock_gettime(1,&now);nova_puts("R24_SYSTEM {\"mono_ns\":");nova_put_u64((unsigned long long)now.tv_sec*1000000000ULL+(unsigned long long)now.tv_nsec);nova_puts(",\"processes\":[");r24_diag_process(1);for(int i=0;i<g_service_count;i++)if(g_services[i].pid>0){nova_puts(",");r24_diag_process((unsigned int)g_services[i].pid);}nova_putln("]}");}
