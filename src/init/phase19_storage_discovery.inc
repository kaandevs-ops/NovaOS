/* Phase-19 Step-3 R1: bounded, fail-closed NovaOS GPT partition discovery.
 * No libc, udev, or /dev/disk symlinks are needed: devtmpfs + sysfs are mounted
 * before mount_stage4_storage().  GUIDs are generated by create-gpt-disk.py
 * via UUIDv5(DISK_GUID, "NovaOS Stage-3A:" + partition name).
 * Scope: Linux virtio-blk vd[a-p] and SCSI/SATA sd[a-p] device families.
 * This is NOT an unrestricted general-purpose block-device enumerator.
 */

static int nova_storage_uevent_has(const char *text, const char *key, const char *value) {
    nova_size_t k=nova_strlen(key), v=nova_strlen(value);
    const char *line=text;
    if(!text || !key || !value) return 0;
    while(*line){
        const char *end=line;
        while(*end && *end!='\n') end++;
        if((nova_size_t)(end-line)==k+1+v){
            nova_size_t i=0;
            while(i<k && line[i]==key[i]) i++;
            if(i==k && line[k]=='='){
                i=0;
                while(i<v && line[k+1+i]==value[i]) i++;
                if(i==v) return 1;
            }
        }
        line=(*end=='\n')?end+1:end;
    }
    return 0;
}

/* All four partitions must come from the same block disk, with their exact
 * deterministic GPT PARTUUID and PARTNAME; never select by mutable /dev order.
 */
static int nova_storage_partition_matches(const char *dev, int role){
    static const char *const guids[4]={
        "ba2e8a50-cca4-5b64-98a3-a156bc002542", /* NOVA_SYSTEM_A */
        "c7b49bc0-20b1-554b-a784-d1ea8f96cb62", /* NOVA_SYSTEM_B */
        "a5649d61-b83b-5427-a2f6-c7c11d58e7b3", /* NOVA_RECOVERY */
        "ab1a50ea-89e6-5621-8391-01069fc89bc2"  /* NOVA_DATA */
    };
    static const char *const names[4]={
        "NOVA_SYSTEM_A", "NOVA_SYSTEM_B", "NOVA_RECOVERY", "NOVA_DATA"
    };
    char path[80], data[512], partn[2];
    if(role<0 || role>3) return 0;
    copy_string(path,sizeof(path),"/sys/class/block/");
    if(!append_checked(path,sizeof(path),dev) ||
       !append_checked(path,sizeof(path),"/uevent")) return 0;
    if(read_text_file(path,data,sizeof(data))<0) return 0;
    partn[0]=(char)('2'+role); partn[1]='\0';
    return nova_storage_uevent_has(data,"DEVTYPE","partition") &&
           nova_storage_uevent_has(data,"DEVNAME",dev) &&
           nova_storage_uevent_has(data,"PARTN",partn) &&
           nova_storage_uevent_has(data,"PARTUUID",guids[role]) &&
           nova_storage_uevent_has(data,"PARTNAME",names[role]);
}

static int nova_discover_storage_devices(void){
    char winner[8]="";
    unsigned int matches=0;
    nova_zero(g_nova_storage_paths,sizeof(g_nova_storage_paths));

    for(int family=0;family<2;family++){
        for(int index=0;index<16;index++){
            char disk[5], dev[12];
            disk[0]=(family==0)?'v':'s'; disk[1]='d';
            disk[2]=(char)('a'+index); disk[3]='\0';
            int complete=1;
            for(int role=0;role<4;role++){
                copy_string(dev,sizeof(dev),disk);
                char num[2]={(char)('2'+role),'\0'};
                if(!append_checked(dev,sizeof(dev),num) ||
                   !nova_storage_partition_matches(dev,role)){
                    complete=0; break;
                }
            }
            if(complete){
                matches++;
                if(matches>1){
                    /* A cloned GPT image is ambiguous: do not mount or mutate
                     * either copy; trust policy must remain fail-closed. */
                    return 0;
                }
                copy_string(winner,sizeof(winner),disk);
            }
        }
    }
    if(matches!=1) return 0;
    for(int role=0;role<4;role++){
        char number[2]={(char)('2'+role),'\0'};
        copy_string(g_nova_storage_paths[role],sizeof(g_nova_storage_paths[role]),"/dev/");
        if(!append_checked(g_nova_storage_paths[role],sizeof(g_nova_storage_paths[role]),winner) ||
           !append_checked(g_nova_storage_paths[role],sizeof(g_nova_storage_paths[role]),number)){
            nova_zero(g_nova_storage_paths,sizeof(g_nova_storage_paths));
            return 0;
        }
    }
    return 1;
}
